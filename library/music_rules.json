  "music_library_source": {
    "application": "Music",
    "access_method": "AppleScript",
    "source_playlist": "collab",
    "track_collection_expression": "tracks of playlist collab",
    "track_properties": {
      "song_id": "persistent ID",
      "song_name": "name",
      "genre": "genre",
      "bpm": "bpm"
    },
    "classification_property": "genre",
    "classification_note": "test.py currently reads name and bpm from tracks in collab. Genre classification should read genre of each track from the same playlist."
  },
  
  "song_assignment_policy": {
    "source_song_set": "all_songs",
    "source_playlist": "collab",
    "genre_input": "genre of Apple Music track",
    "genre_input_type": "string",
    "genre_matching": "case_insensitive_exact_name",
    "multiple_genre_delimiters": [
      ";",
      ","
    ],
    "never_split_on": "/",
    "multiple_genres": "split_then_union_all_matching_categories",
    "prevent_duplicate_song_ids_inside_set": true,
    "song_unique_key": "persistent ID",
    "unmapped_genre": "keep_in_all_songs_only",
    "others_song_source": "all_songs"
  },
  "context_matching_policy": {
    "input": "detected_display_name",
    "priority": [
      "website",
      "app",
      "default"
    ],
    "normalize_whitespace": true,
    "case_insensitive": true
  },

  "no_music_websites": {
  "action": "pause_music",
  "resume_after_leaving": true,
  "names": [
    "Bilibili",
    "YouTube",
    "YouTube TV",
    "Netflix",
    "Disney+",
    "HBO",
    "HBO Max",
